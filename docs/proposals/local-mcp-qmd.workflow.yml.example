name: Temporary vAFS configured MCP QMD checks
on:
  create:
permissions:
  contents: read
jobs:
  configured-qmd:
    if: github.repository == 'alvarovillalbaa/vafs' && github.event.repository.private == false && github.event.ref_type == 'branch' && github.event.ref == 'qa/vafs-local-mcp-qmd-20261113-2'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: APPROVED_SOURCE_COMMIT
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Start owned deadline
        run: echo "PROFILE_STARTED_EPOCH=$(date +%s)" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          fetch-depth: 4
          clean: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 26.13.0
          package-manager-cache: false
      - name: Eight profile contracts and real native MCP Q02
        id: scope
        run: python3 tests/scripts/run-local-mcp-qmd.py
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        id: proof
        if: always()
        with:
          name: vafs-local-mcp-qmd-${{ github.run_id }}
          path: ${{ runner.temp }}/vafs-local-mcp-qmd-${{ github.run_id }}.json
          if-no-files-found: error
          retention-days: 1
      - name: Retire exact uploaded proof
        if: always() && steps.proof.outcome == 'success' && steps.scope.outputs.report_sha != ''
        env:
          REPORT_SHA: ${{ steps.scope.outputs.report_sha }}
          REPORT_DEV: ${{ steps.scope.outputs.report_dev }}
          REPORT_INO: ${{ steps.scope.outputs.report_ino }}
        run: python3 tests/scripts/run-local-mcp-qmd.py --retire
